# Plantilla de configuración. Copia este archivo a .env y completa lo que está vacío.
# .env NUNCA se sube al repositorio.

# --- Acceso al servicio (el evaluador manda este token en Authorization: Bearer) ---
TEAM_TOKEN=

# --- IA (OpenRouter) ---
OPENROUTER_API_KEY=
OPENROUTER_BUDGET_USD=
LLM_MODEL=google/gemini-3.8-flash
LLM_SEND_IMAGE=false

# --- Topes por tarea ---
TASK_MAX_SECONDS=270
TASK_MAX_COST_USD=0.15
TASK_MAX_STEPS=40

# --- Clic y teclado (milisegundos) ---
CLICK_HOLD_MS=150
CLICK_MOVE_MS=100
KEY_HOLD_MS=50
TYPE_HOLD_MS=30

# --- Espera de pantalla ---
SCREEN_STABLE_DIFF=0.01
SCREEN_STABLE_MAX_S=3
SCREEN_POLL_S=0.4
SCREEN_FIRST_WAIT_S=0.6

# --- VNC y lectura de texto ---
VNC_CONNECT_RETRIES=1
OCR_LANG=spa
OCR_SCALE=2

# --- Solo para bench.py (tu escritorio de práctica; el evaluador manda el suyo en POST /tasks) ---
DESKTOP_URL=
DESKTOP_PASSWORD=
DESKTOP_TOKEN=
